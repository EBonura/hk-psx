loop d06b-h001 until expr (abs(i32(HK_PLAYER_X) - 2671903) <= 58982 || (i32(HK_PLAYER_X) >= 2601779 && i32(HK_PLAYER_X) <= 3070362)) && abs(i32(HK_PLAYER_Y) - 615383) <= 19661 max 3 timeout 900
walk 35.65
walk 35.22   # run-up
walk 35.65   # take-off
hold right+cross for 34
hold right for 3
wait 6
wait until HK_WALK_READY == 1 timeout 300
end

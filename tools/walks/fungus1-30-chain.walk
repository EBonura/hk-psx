heal
walk 92.43   # run-up
walk 92.86   # take-off
hold right+cross for 24
wait 6
wait until HK_WALK_READY == 1 timeout 300
wait until expr abs(i32(HK_PLAYER_X) - 1376256) <= 327680 && abs(i32(HK_PLAYER_Y) - -32768) <= 393216 timeout 600
wait until HK_GAME_MODE == 1 timeout 1800

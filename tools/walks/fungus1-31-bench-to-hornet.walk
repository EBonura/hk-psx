# The back half of the walk to Hornet, from the bench save in Fungus1_31 just loaded by Continue (SOUL 0, full masks): the climb (31b), Fungus1_32,
# Fungus1_20_v02 and 21 to Hornet, Hornet beaten fairly, the Cloak and the first dash. walk-new-game-to-hornet plays it after a power cycle at that
# bench and walk-fungus1-31-bench-to-hornet plays it from the card such a run saved there, so the two are the same run from the same boot: the
# chain cannot fail here while the segment passes (docs/ROUTES.md, "The walk to Hornet in two boots").
check bench-loaded HK_SAVE_LOADED == 1 ; HK_DEATHS == 0 ; HK_CHEATS == 0 ; HK_HEALTH >= 5 ; x between 26.5 28.2 ; y between 50.5 52.5
include fungus1-31b-chain.walk
include fungus1-32-chain.walk
include fungus1-20v02-chain.walk
include fungus1-21-chain.walk
wait until HK_WALK_READY == 1 timeout 300
include fungus1-04.walk
wait until HK_HORNET_ENCOUNTERS == 1 timeout 300
wait until expr u8(HK_HERO_LOCK) == 1 timeout 300                      # her greeting has taken hold of the Knight (the lock can come a few ticks after the encounter count)
loop greeting until expr u8(HK_HERO_LOCK) == 0 max 14 timeout 1800   # her greeting panel turns a page on each Cross edge (hornet.rs convo_tick), so each press needs the pad seen released again: wait for the game to consume the release, not a count of ticks
press cross
wait until expr (u32(HK_SIM_PAD) & 16384) == 0 timeout 60
end
wait until expr u8(HK_HERO_LOCK) == 0 timeout 900
include hornet-defs.walk
check sealed HK_HORNET_ENCOUNTERS == 1 ; HK_ARENA_GATE_CLOSES >= 1 ; HK_DEATHS == 0 ; HK_CHEATS == 0
hold left until x le 28.8 timeout 200                              # out of the right corner before she wakes: the gate she is sealed behind leaves the Knight at x 32.4, and her leaps pin him to that wall
loop hornet-fight until expr u32(HK_HORNET_PHASE) >= 2 || u32(HK_DEATHS) > 0 max 5000 timeout 30000
include hornet-round.walk
end
wait until HK_HORNET_PHASE == 3 timeout 900
wait until expr u16(HK_HORNET_CLOAK_WAIT) == 0 timeout 900
check hornet-gone HK_HORNET_HP == 0 ; HK_ARENA_GATE_OPENS >= 1 ; HK_DEATHS == 0 ; HK_CHEATS == 0 ; HK_HORNET_ENCOUNTERS == 1
walk 23.2
wait until HK_WALK_READY == 1 timeout 300
repeat 3 press up rest 45
wait 120
check cloak expr (u32(HK_WORLD_PLAYER) & 67108868) == 67108868 ; HK_DEATHS == 0
check no-item-banner expr u32(HK_TITLE_CARD) != 255                  # the Cloak is announced by its item panel alone: the corner item banner of a charm or relic pickup must not name it too
check fx-before HK_FX_DASH_RAISED == 0
press cross                                                          # closes the item panel
check pack-resident expr (u8(HK_MODULE_RESIDENT + 5) & 1) == 1   # art_fx (module 40, data/modules.rs ART_FX) was read while the panel was up
hold right+r2 for 20                                                 # the first dash, at once
wait 40
check dash HK_FX_DASH_RAISED >= 1 ; HK_ABILITY_DRAWN >= 5 ; HK_BOSS_DROPS == 0 ; HK_BOSS_CLIP_MISSES == 0 ; HK_ROOM_LOAD_ERROR == 0 ; HK_CD_STREAM_ERROR == 0
check no-card-no-cheat HK_CHEATS == 0 ; HK_DEATHS == 0 ; HK_INPUT_MISSED_VBLANKS == 0

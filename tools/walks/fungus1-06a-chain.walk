# Fungus1_06 from the arrival in the west (x 0.5, y 16.4) to the first hanging platform (x 32.5, y 15.1).
# Planned with hk-walkplan room on the disc (HK_WALKPLAN_MARGIN=0.4, sync poll) with the whole run before it as the pre, 2026-11-03.
at 0.50 16.40
loop d06a-h001 until expr abs(i32(HK_PLAYER_X) - 522322) <= 58982 && abs(i32(HK_PLAYER_Y) - 811991) <= 19661 max 3 timeout 900
walk 2.44
walk 2.01   # run-up
walk 2.44   # take-off
hold right+cross for 12
hold right for 28
wait 6
wait until HK_WALK_READY == 1 timeout 300
end

name walk-title-cards
title the current area is saved: a Continue from a save made in Dirtmouth does not announce Dirtmouth again (AreaTitleController.Finish, PlayerData currentArea)
max_ticks 12000
sync poll
# town-continue.mcd was written before the save carried the current area, so its Continue announces Dirtmouth once (the bench is
# inside the Area Title Controller's trigger). A save at that bench now carries it, and the Continue after a power cycle is
# silent, as the original's is. HK_TITLE_CARD is the title index plus one (data/title_cards.rs: DIRTMOUTH 1).
card town-continue.mcd
include title-continue.walk
wait until HK_TITLE_CARDS >= 1 timeout 900
check announced HK_TITLE_CARDS == 1 ; HK_TITLE_CARD == 2
wait 600                                       # the card has gone
press up                                       # sit: Save game?
wait until HK_SAVE_UI == 1 timeout 600
press cross                                    # Yes
wait until HK_SAVE_WRITES ge 1 timeout 900
wait until HK_SAVE_UI == 0 timeout 900
check saved HK_SAVE_ERRORS == 0 ; HK_DEATHS == 0 ; HK_CHEATS == 0
include continue-reload.walk
wait 600                                       # longer than Dirtmouth's visited pause and the card's fade in
check silent HK_TITLE_CARDS == 0 ; HK_SAVE_LOADED == 1

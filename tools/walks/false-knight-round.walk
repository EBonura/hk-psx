# One round of the False Knight fight, in the order of what matters (false-knight-defs.walk has the expressions). A reaction
# costs no time when there is nothing to react to, so a round with nothing to do is the final `wait 3`; every long hold also
# ends when a slam wave comes, and the next round begins by jumping it.
hold cross until expr !$wave_near timeout 120                                   # jump a slam wave that is nearly here
hold circle until expr !$want_focus || $wave_near timeout 400                   # Focus while he is far off
wait until HK_FOCUS_LOCKED == 0 timeout 200
hold left until expr !$threat_right || $wave_near timeout 900                   # give ground while he winds up or is in the air
hold right until expr !$threat_left || $wave_near timeout 900
hold left until expr !($raging && $px > 12 * 65536) || $wave_near timeout 900   # a rage: stay at the far end, strike nothing
hold right until expr !$down_right || $wave_near timeout 900                    # the floor has broken: drop after him
hold left until expr !$down_left || $wave_near timeout 900
hold right until expr !$under_right || $wave_near timeout 400                   # armour rolling or open: stand under the Head
hold left until expr !$under_left || $wave_near timeout 400
hold cross until expr !($reach_jump && $ready) timeout 60                       # the Head is above a swing: jump to it
hold right until expr !$close_right || $wave_near timeout 300                   # idle and out of reach: close on him
hold left until expr !$close_left || $wave_near timeout 300
hold up+square until expr !($reach_up && $ready) timeout 90                     # swing at whatever a nail would land on
wait until HK_NAIL_BUSY == 0 timeout 90
hold right until expr !($reach_right && $ready && i32(HK_PLAYER_FACING) < 0) timeout 10
hold square until expr !($reach_right && $ready) timeout 90
wait until HK_NAIL_BUSY == 0 timeout 90
hold left until expr !($reach_left && $ready && i32(HK_PLAYER_FACING) > 0) timeout 10
hold square until expr !($reach_left && $ready) timeout 90
wait until HK_NAIL_BUSY == 0 timeout 90
wait 3

# The first half of the milestone walk to Hornet: no seeded wallet, no card, no cheat, every step waits on game state. Each fragment is the planned one of
# the room; the walk checks the Geo, masks and SOUL it arrives with so the second half (Fungus1_06 to the Hornet fight) knows what it starts from.
include new-game.walk
include kings-pass.walk
include dirtmouth.walk
include crossroads-01.walk
include crossroads-07.walk
include crossroads-33.walk
include crossroads-08.walk
include crossroads-13.walk
include crossroads-42.walk
include crossroads-19.walk
include crossroads-03a.walk
include crossroads-47a.walk
include crossroads-47b.walk
include crossroads-03b.walk
include crossroads-21.walk
include crossroads-10.walk
include false-knight.walk
include city-crest.walk
include chest.walk
check crest HK_FK_DEATHS == 1 ; HK_PICKUPS_TAKEN == 1 ; HK_CHESTS_OPENED == 1 ; HK_DEATHS == 0 ; HK_CHEATS == 0 ; expr (u32(HK_WORLD_PLAYER) & 256) != 0
include crest-exit.walk
include crossroads-06.walk
include mound-bench.walk
include mound-spell.walk
include mound-exit.walk
wait until HK_WALK_READY == 1 timeout 300
check spell HK_SPELL_EARNED == 1 ; HK_SOUL >= 99 ; HK_DEATHS == 0 ; HK_CHEATS == 0
include crossroads-06-from-mound.walk
include crossroads-33-up.walk
wait until HK_WALK_READY == 1 timeout 300
include crossroads-07-up.walk
wait until HK_WALK_READY == 1 timeout 300
include baldur-defs.walk
include crossroads-11-alt.walk
loop baldur until expr u32(HK_BLOCKERS_DEAD) != 0 max 400 timeout 9000
include baldur-round.walk
end
heal
heal
wait until HK_WALK_READY == 1 timeout 300
check baldur-dead HK_BLOCKERS_DEAD >= 1 ; HK_DEATHS == 0 ; HK_CHEATS == 0 ; HK_HEALTH >= 1
include crossroads-11-alt-west-chain.walk
include fungus1-01-chain.walk
include fungus1-01b-chain.walk
include fungus1-02-chain.walk
wait until HK_WALK_READY == 1 timeout 300
check in-fungus1-06 x between 0 6 ; y between 14 19 ; HK_DEATHS == 0 ; HK_CHEATS == 0 ; HK_HEALTH >= 1 ; HK_GEO_WALLET >= 40

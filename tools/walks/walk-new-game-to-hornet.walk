name walk-new-game-to-hornet
title one run from a new game to Hornet beaten: the False Knight and the Crest, the Mound's spell, Crossroads_33 and 07 to the Elder Baldur, Greenpath west (01, 01b, 02, the vine room 06 with two cuts, 07, 19, 10, 30), the toll and the bench in Fungus1_31, a power cycle and Continue there, its climb, then 32, Fungus1_20_v02 and 21 to Hornet, the Cloak and the dash; no seeded card or wallet, no cheat
max_ticks 260000
sync poll
# Without the Moss Knight and Vengefly King fights (not in the port yet): the fair route is this one plus those.
include chain-new-game-to-greenpath.walk
include fungus1-06a-chain.walk
include fungus1-06-vine1.walk
include fungus1-06b-chain.walk
include fungus1-06b2-chain.walk
include fungus1-06v4-chain.walk
check vine-4 HK_BREAK_COUNT >= 2 ; HK_DEATHS == 0 ; HK_CHEATS == 0
include fungus1-06c-chain.walk
include fungus1-07-chain.walk
include fungus1-19-chain.walk
include fungus1-10-chain.walk
include fungus1-30-chain.walk
include fungus1-31a-chain.walk
include fungus1-31-toll-chain.walk
# The save the bench just wrote is the start of the second half: power off and on and Continue (a player's own save, no seeded card), then the
# back half exactly as walk-fungus1-31-bench-to-hornet plays it from the card such a run saved here. Everything before this point cannot move it.
include continue-reload.walk
include fungus1-31-bench-to-hornet.walk

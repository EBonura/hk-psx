# Canonical reload of that completed save on the same emulator has 662
# slow frames; matched region transitions differ by at most two polls.
# The open-loop tape of this route drifts on emulator 0e87b3a (chained cards), so its frames are never judged and it
# has no frame_time or long_frames (tests in host/hk-build/routes.rs); the closed loop judges the route.
pacing = 861
journey = 4
scene_gate = true
# journey-reload boots that card and walks the same way back towards the
# arena, and where it used to cross the arena floor it now falls through
# the broken one before it reaches the Battle Scene trigger. The boss
# never leaves the ceiling: nothing triggered, nothing dropped, the gates
# quick-opened on entry and never closed, and the Crossroads_10 gates are
# open (ARENA_GATES 1 is Crossroads_04's gate, closed on load, alone). The
# seven items restored are the six King's Pass walls and the arena.
HK_SAVE_LOADED = 1
HK_WORLD_RESTORED = 10
HK_WORLD_ITEMS = 11
HK_WORLD_PLAYER = 259
HK_FK_TRIGGERED = 0
HK_FK_DROPPED = 0
HK_FK_DEATHS = 0
HK_FK_ACTIVATED = 1
HK_FK_ARENA = 4
HK_ARENA_GATE_CLOSES = 0
HK_ARENA_GATE_OPENS = 1
HK_ARENA_GATES = 1
# The floor stays broken on the reload, so the walk that used to cross
# the arena floor drops through the hole into the room below instead.
HK_DEATHS = 0
HK_REGION_ID = 232
HK_FK_FLOOR = 2
# Taking the Crest records a world item (11) and sets the player flag hasCityKey (bit 8: 3 becomes 259).
# The reward (docs/FALSE_KNIGHT.md, hk-fk-audit item 3). The tape goes on from the room below the broken
# floor: 75 polls right to x 37.9, UP (the shiny's inspect press), and a wait for the kneel. The City Crest
# (Key Giver, Crossroads_10, hasCityKey) is taken, and nothing else: judged on the game state, not on
# the banner, which the presentation lanes change. The 200 Geo chest (x 6.7, y 12.8, behind Battle Gate
# 2 (1)) is not here: it sits about 9 units above this room's floor, and the Knight who walks left
# along the floor leaves the room at x 6 instead. A route to it has to climb; HK_CHESTS_OPENED
# stays unpinned until one exists.
HK_PICKUPS_TAKEN >= 1
HK_HEALTH >= 5

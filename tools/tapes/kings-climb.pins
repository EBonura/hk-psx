# The King's Pass climb, which reproduced in the probe and had never been
# done on the disc, and the first cooked script to fire in Tutorial_01:
# FLAGS bit 0 is seenFocusTablet. The climb needs no ability, it needs to
# survive two Crawler hits, which is what the Invincibility grant buys;
# ctrl-climb was the same tape without the grant and reaches none of it.
# Since the nail recoils off terrain (2026-11-23) this tape swings on the climb
# only where it breaks something (tools/tapes/kings-climb.route): the swings it
# made against the shaft walls pushed the Knight off his jumps. ctrl-climb keeps
# the recorded swings; it passes on them, and on this tape it reports 30 frames
# of late prop art (HK_MODULE_ART_LATE) on the path it then takes.
# Kills, hits and SOUL are not pinned (2026-11-25, docs/REPIN-LOG.md): incidental to the blind swings,
# they move with frame timing.
HK_CHEATS = 1

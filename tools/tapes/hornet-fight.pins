card = hornet-road.mcd
pacing = 6000
frame_time = 400
long_frames = 8
# The road to her arena (the hornet-road tape), then: her greeting is turned through with four Crosses; the pause menu's Invincible
# and Pure Nail cheats are toggled (HK_CHEATS 3), so no mask is lost and her 225 points are eleven strikes; a Square mash with
# a left and right sweep kills her (she goes through phase 1, dies in phase 2 and is gone in phase 3); her corpse writes
# hornet1Defeated (PlayerData bit 26); the Knight walks to the shiny, UP takes the Cloak (bit 2), the item-get panel is closed
# and the dash runs both ways. HK_WORLD_PLAYER bits 26 and 2 are 67108868. Authored on the emulator in docs/HORNET.md's terms:
# deterministic from the load into her room, so it has to be redone when code that moves the polls changes.
HK_SCENE_GATE_LOADS = 2
HK_REGION_ID = 1005
HK_DEATHS = 0
HK_HEALTH = 5
HK_CHEATS = 3
HK_HORNET_ENCOUNTERS = 1
HK_HORNET_PHASE = 3
HK_HORNET_HP = 0
HK_WORLD_PLAYER = 67108868
HK_BOSS_BANK_FOUND = 70
HK_BOSS_DROPS = 0
HK_BOSS_CLIP_MISSES = 0
HK_ABILITY_DRAWN >= 5
HK_ROOM_LOAD_ERROR = 0
HK_CD_STREAM_ERROR = 0

# 2026-10-30 (entrance light): the entrance landing's orange clouds cost about ten frames of three vblanks in this route (frames over 2 vblanks 1 before, 12 and 8 after; frame time 148 to 151 of 196); a fight's one-second effect, kept for the look (docs/BUDGET.md, docs/EFFECTS.md).
art_late = 44
# Losing to the False Knight, and walking back in for a second go.
# 
# boss-fight above is the win. This is the loss, and the two together are
# what P21 actually asks for. A Knight who presses nothing after walking
# into the trigger is dead in 1,002 polls, on five separate hits.
# 
# What the second half proves is the retry. The death leaves a Shade in the
# arena, respawns at the seat with five masks, resets the arena to Waiting
# and restores the boss to 65 and 40, and the closed gate goes back to its
# placement state on the same tick the scene reloads, so nothing is sealed
# in with nothing to fight. Walking right again drops the boss a second
# time: TRIGGERED and DROPPED are 2, and GATE_CLOSES is 2.
# 
# The tape stops at poll 1,600 and that is not where the second fight ends. An earlier build
# collapsed at poll 1,897, about 490 polls into it (two missed VBlanks per poll, the input queue
# climbing until the sampler faulted QueueFull and the guest panicked). On main 2a79fc7 it does not
# reproduce: the hk-fk-audit lane played the retry out to 3,750 polls with a Shade in the room and
# the frame held. The tape is still cut at 1,600 because the pins below are measured there; a longer
# one is possible, and its pins have to be measured again.
#
# The Knight wakes 24 ticks later than he did (the killing hit's hit stop, vitals.rs DEATH_FREEZE_TICKS), so the
# second walk right is held to poll 1,545 instead of 1,519 (tape-hold) and still reaches the trigger.
HK_CHEATS = 0
HK_DEATHS = 1
HK_SHADE_PRESENT = 1
HK_SHADE_HP = 10
HK_FK_TRIGGERED = 2
HK_FK_DROPPED = 2
HK_FK_HP = 65
HK_FK_HEAD_HP = 40
HK_FK_ARENA = 2
HK_FK_DEATHS = 0
HK_FK_STAGGERS = 0
HK_ARENA_GATE_CLOSES = 2
HK_SCENE_LOADS = 1
HK_ENEMY_KILLS = 0
HK_SAVE_LOADED = 1
HK_SAVE_ERRORS = 0
HK_REGION_ID = 239
HK_FK_FLOOR = 0
# Alive when the tape runs out. How many masks the second fight has cost by
# then is frame timing; HK_DEATHS 1 above is the assertion that he died
# exactly once and got back up.
HK_HEALTH >= 1
# The Knight died at the False Knight: the dark slashes burst, the screen faded out, held black for
# 48 ticks, and he woke asleep and then waking (the card's marker is not a bench).
HK_BENCH_WAKES = 1
HK_GROUND_WAKES = 0
HK_HIT_FX_BURSTS = 5
HK_DEATH_HOLD_TICKS = 48
